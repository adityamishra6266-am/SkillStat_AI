PORT=5000
FRONTEND_URL=http://localhost:3000

# Use a long random string (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Any local MySQL / MariaDB server (XAMPP's MySQL works too). Change DB_PORT if yours is not 3306.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=skillstat_ai

AI_SERVICE_URL=http://localhost:8000
MAX_FILE_SIZE_MB=10

# Learning providers. Only 'mock' (prototype catalogue) is implemented - there are
# no live iGOT / NSSTA credentials in this project.
IGOT_PROVIDER_MODE=mock
NSSTA_PROVIDER_MODE=mock
