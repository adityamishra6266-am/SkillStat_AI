# AI Service configuration
HOST=0.0.0.0
PORT=8000

# OPTIONAL - LLM configuration. Leave all three empty to run without an LLM.
#   * Document quizzes then use the deterministic EXTRACTIVE generator
#     (questions are built from the uploaded document's own sentences).
#   * The competency assessment uses the curated question bank.
#   * Question -> competency mapping uses the deterministic keyword matcher.
# The UI always shows which mode actually produced a quiz - a fallback is never
# presented as "AI-generated".
# The request shape is the Anthropic Messages API (x-api-key header).
LLM_API_KEY=
LLM_API_URL=
LLM_MODEL=

# CORS - allow the Node backend to call this service
ALLOWED_ORIGIN=http://localhost:5000
