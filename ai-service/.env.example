# AI Service configuration
HOST=0.0.0.0
PORT=8000

# Optional: set this to use a real LLM for quiz generation.
# If left empty, the service automatically falls back to the
# built-in mock quiz generator so the app still works offline.
LLM_API_KEY=
LLM_API_URL=
LLM_MODEL=

# CORS - allow the Node backend to call this service
ALLOWED_ORIGIN=http://localhost:5000
